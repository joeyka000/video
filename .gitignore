# 輸出（SKILL.md 規定寫到 ./out/）
out/

# 參考庫由 session-start hook clone 到 ~/video-lab/refs，不進 repo
refs/

.venv/
node_modules/
__pycache__/
.DS_Store

# 專案素材（音樂、照片、影片）不進公開 repo
projects/**/*.mp3
projects/**/*.wav
projects/**/*.m4a
projects/**/*.mp4
projects/**/*.mov
projects/**/*.jpg
projects/**/*.jpeg
projects/**/*.png
projects/**/*.heic
projects/**/*.webp
projects/**/*.zip

# 專案筆記含個人資訊，不進公開 repo
projects/**/brief.md
# 專案試剪內容含個人暱稱，repo 公開前不 commit
projects/*/tests/

# 素材與含 GPS 的清單不進公開 repo
projects/*/media/
projects/**/manifest*.json
# 專案工作檔含個人資訊（地點、筆記、iCloud 連結），repo 公開期間不 commit
projects/*/*
!projects/*/music/
projects/*/music/*
!projects/*/music/analysis.json

# 分析資料（audio.json、含整首歌詞的 lyrics.json）不進公開 repo
data/
